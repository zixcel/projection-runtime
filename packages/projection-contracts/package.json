{
  "name": "@hathq/projection-contracts",
  "version": "0.10.0",
  "description": "Renderer-independent bounded projection, lineage and Scene contracts",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "contract.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-PREVIOUS"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./client": {
      "types": "./src/client.d.mts",
      "import": "./src/client.mjs"
    }
  },
  "imports": {
    "#hash": {
      "browser": "./src/hash-browser.mjs",
      "default": "./src/hash-node.mjs"
    }
  },
  "dependencies": {
    "ohash": "2.0.11",
    "@zixcel/interaction": "0.10.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 test/public-types.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixcel/projection-runtime.git",
    "directory": "packages/projection-contracts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "types": "./src/index.d.mts",
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.12.0"
  },
  "packageManager": "pnpm@10.29.3"
}
